<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-API-26 fallback: <adaptive-icon> needs API 26+, so devices below that
     get a static composite of the same background+foreground art instead
     (light theme, matching AppIconManager's other pre-26/disabled defaults). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_background" />
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
