            android:icon="@mipmap/ic_launcher_rosepinedawn"
            android:roundIcon="@mipmap/ic_launcher_rosepinedawn_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
